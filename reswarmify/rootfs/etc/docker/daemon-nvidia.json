{
  "data-root": "/opt/reagent/docker-apps",
  "features": { "buildkit": true, "containerd-snapshotter": false },
  "runtimes": {
    "nvidia": {
      "path": "/usr/bin/nvidia-container-runtime",
      "runtimeArgs": []
    }
  },
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}